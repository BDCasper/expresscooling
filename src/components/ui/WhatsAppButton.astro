---
import { whatsappHref } from '../../lib/links';
import Icon from './Icon.astro';

interface Props {
  /** Метка источника для аналитики: hero, card-<slug>, footer */
  source: string;
  variant?: 'solid' | 'inline';
  /**
   * Размер варианта solid: `md` (56px, дефолт — hero и большинство мест),
   * `sm` (46px — шапка от md, node 1:471/1:923) или `round` (44px круг без
   * подписи — шапка ниже md, см. комментарий у solidSizes.round). Разница
   * между md/sm не только в высоте, но и в горизонтальных отступах и
   * размере значка — все три числа заданы дизайнером отдельно для узкой
   * пилюли, не пропорциональным уменьшением.
   */
  size?: 'md' | 'sm' | 'round';
  label?: string;
  /**
   * Короткая подпись для мобильных ширин (< md), например «WhatsApp» вместо
   * «Написать в WhatsApp» — так в шапке на макете 1:923. По умолчанию равна
   * `label`, то есть ничего не меняется для мест, где короткий вариант не
   * нужен. Рендерятся оба варианта одной ссылкой (см. ниже), не двумя
   * инстансами компонента — второй набор data-cta задвоил бы клики в
   * аналитике.
   */
  mobileLabel?: string;
  class?: string;
  /**
   * Только для variant="inline" (карточки поломок, node 1:90 — жёлтая,
   * 1:105 и малые карточки — белые). В макете это текст + стрелка после
   * него (icon-arrow-up-right / -alt), а не значок WhatsApp — и цвет
   * текста, и то, какой из двух файлов стрелки рисуется, зависят от фона
   * карточки: #0B6B4F + icon-arrow-up-right на белом, #084C36 +
   * icon-arrow-up-right-alt на жёлтой. Оба значения — точные заливки из
   * get_design_context (узлы 1:101/1:114) и совпадают с зашитым цветом
   * самих SVG (см. Icon.astro: цвет запечён в файле, не currentColor) —
   * поэтому выбор файла обязан произойти здесь, на сервере, а не через
   * CSS-переопределение. На variant="solid" не влияет.
   */
  onAmber?: boolean;
}

const {
  source,
  variant = 'solid',
  size = 'md',
  label = 'Написать в WhatsApp',
  mobileLabel = label,
  class: className = '',
  onAmber = false,
} = Astro.props;

const base =
  'inline-flex items-center font-semibold transition-[background-color,box-shadow,transform] duration-200 ease-soft focus-ring';

/**
 * Зазор между иконкой и текстом — часть solidSizes, а не base: для `sm`
 * (шапка) ниже md он уже, чем стандартный gap-3 (gap-1), чтобы на 390px
 * короткая подпись `mobileLabel` помещалась в одну строку рядом с
 * обязательно-нерасходной (см. Header.astro) надписью логотипа — там
 * оба текста впритык делят одну строку шапки. От md кнопка показывает
 * полный `label`, а логотип уже не соперничает с ней за одну и ту же
 * узкую строку, поэтому там зазор возвращается к обычным gap-3. Сам
 * зазор нигде не задан пиксельно в списке замечаний (в отличие от
 * padding/высоты/иконки), поэтому именно им безопаснее всего
 * пожертвовать на самой тесной ширине.
 */
/**
 * `round` (шапка ниже md, node про PhoneButton variant="round" в Hero —
 * тот же приём, перенесённый на кнопку WhatsApp по правке ревью): круг
 * 44px, только значок, без подписи. Раньше на этой ширине кнопку просто
 * прятали целиком (не хватало места рядом с бургером) — единственная
 * липкая точка конверсии, доступная с любого места страницы, пропадала
 * именно там, где мобильного трафика больше всего. Круглая кнопка занимает
 * меньше места, чем даже короткая подпись `sm`, и решает это без потери
 * самой кнопки. justify-center — необходим: base не центрирует одиночную
 * иконку без текста по горизонтали внутри квадрата.
 */
const solidSizes = {
  md: 'h-14 gap-3 pl-9 pr-6 text-[18px]',
  sm: 'h-[46px] gap-1 md:gap-3 pl-[29px] pr-[21px] text-[17px]',
  round: 'h-11 w-11 shrink-0 justify-center',
};

/**
 * Зазор inline-варианта — 7px (node 1:102 "Icon:margin", pl-[7px] перед
 * стрелкой), не стандартный gap-3 (12px): это отдельное число из макета
 * для этой конкретной пары текст+иконка, не унаследовано от solid.
 * Прежний hover:gap-4 (зазор расширялся целиком) убран — по правке
 * ревью «оживляет» карточку сама стрелка (см. группа .group-hover ниже
 * на <Icon>), а не зазор.
 */
const variants = {
  solid: `rounded-pill bg-wa text-wa-ink hover:bg-[#2ee070] hover:shadow-[0_8px_24px_-8px_rgba(37,211,102,0.6)] ${solidSizes[size]}`,
  inline: `gap-[7px] text-[17px] ${onAmber ? 'text-[#084c36]' : 'text-[#0b6b4f]'}`,
};

const iconSize = size === 'round' ? 20 : size === 'sm' ? 19 : 21;
const inlineArrowIcon = onAmber ? 'icon-arrow-up-right-alt' : 'icon-arrow-up-right';
const isRound = size === 'round';
---

<a
  href={whatsappHref()}
  data-cta={source}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={isRound ? label : undefined}
  class={`${base} ${variants[variant]} ${className}`}
>
  {variant === 'solid' && <Icon name="icon-whatsapp-button" size={iconSize} />}
  {!isRound && <span class="hidden md:inline">{label}</span>}
  {
    /*
      whitespace-nowrap — короткая подпись обязана остаться в одну строку
      (см. комментарий у логотипа в Header.astro: то же требование ревью).
      Раньше здесь стоял break-words как аварийный клапан на случай, если
      места не хватит, — при mobileLabel="WhatsApp" в шапке на 390px это
      реально случалось, и слово ломалось посередине («WhatsAp» / «p»), а
      не просто переносилось. Правильное решение — не ловить нехватку
      места переносом, а убрать её (см. gap-1 у solidSizes.sm выше и
      gap-1.5 у логотипа в Header.astro), и требовать нужную строку явно
      через nowrap, а не подстраховываться поломкой слова.

      text-[14px] вместо унаследованных 17px — тоже часть того же бюджета
      места: на 390px после фиксированных значка/паддингов (item 4:
      19/29/21) и нерезинового текста логотипа рядом почти не остаётся
      места для текста кнопки. С 17px и даже с 15px запас получался
      нулевым или в районе 1px — элементы визуально соприкасались с
      логотипом без видимого зазора. 14px даёт настоящий, а не
      теоретический зазор (~8px на 390px, проверено скриншотом). Размер
      шрифта нигде в списке замечаний не зафиксирован — только паддинги,
      высота и значок — поэтому именно им безопасно пожертвовать здесь,
      не трогая соответствие макету по остальным четырём числам. Только
      для короткой подписи: полный `label` от md сохраняет унаследованные
      17px.
    */
  }
  {!isRound && <span class="whitespace-nowrap text-[14px] md:hidden">{mobileLabel}</span>}
  {
    /*
      group-hover — карточка поломки оборачивает эту кнопку в class="group"
      (BreakageCard.astro), поэтому стрелка сдвигается на 2px вправо-вверх
      при наведении на всю карточку, не только на саму ссылку — так в
      макете. translate-x-0.5/-translate-y-0.5 = 2px при --spacing:0.25rem
      (дефолт Tailwind v4, в проекте не переопределён). Там, где variant
      solid, .group-hover ничего не делает без предка .group — не мешает.
    */
  }
  {
    variant === 'inline' && (
      <Icon
        name={inlineArrowIcon}
        size={16}
        class="transition-transform duration-200 ease-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    )
  }
</a>
