---
/**
 * Полифилл анимации появления (.reveal/.reveal-soft/.reveal-stagger) для
 * браузеров без animation-timeline: view() — на момент написания это
 * Firefox с настройками по умолчанию. Без него CSS в global.css молча
 * прячет весь помеченный контент (opacity: 0) и никто его обратно не
 * показывает: пустая страница хуже, чем страница без анимаций.
 *
 * Подключается в Base.astro, в <head>, как можно раньше: класс js-reveal
 * обязан встать до первой отрисовки, иначе будет заметная вспышка контента.
 * Если браузер сам умеет animation-timeline: view() или в нём нет
 * IntersectionObserver — полифилл не нужен и не трогает документ вовсе;
 * тогда лучше не скрывать контент, чем скрыть и не вернуть обратно.
 *
 * Бюджет инлайн-JS на страницу — 6 КБ (6144 байта) в сыром виде, суммарно
 * со всеми встроенными скриптами страницы (аналитика из Base.astro, этот
 * полифилл, бургер-меню из Header.astro). Поднят с исходных 4.5 КБ ради
 * бургер-меню (задача "burger-blur") — три скрипта уже весили 4444 байта
 * из 4608, новому просто было некуда влезть. Экономия ценой нечитаемого
 * кода по-прежнему не оправдана: минификация в одну строку экономит лишь
 * сотни байт до gzip и один раз уже прятала баг от собственного чтения
 * (см. progress.md, Task 6). Проверяется автоматически в
 * tests/e2e/budget.spec.ts. Комментарии, которые не объясняют неочевидное
 * прямо у кода, — здесь, во фронтматтере, откуда они не попадают в сборку.
 */
---

<script is:inline>
  (function () {
    if (CSS.supports('animation-timeline', 'view()')) return;
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Ставится синхронно, до первой отрисовки: CSS скрывает контент по
    // этому классу, поэтому без него (скрипт не выполнился) правила
    // скрытия просто не применятся, и контент останется видимым.
    document.documentElement.classList.add('js-reveal');

    addEventListener('DOMContentLoaded', function () {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -10% 0px' });

      document.querySelectorAll('.reveal, .reveal-soft, .reveal-stagger').forEach(function (el) {
        io.observe(el);
      });
    });
  })();
</script>
