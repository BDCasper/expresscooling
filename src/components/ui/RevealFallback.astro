---
/**
 * Полифилл анимации появления (.reveal/.reveal-soft/.reveal-stagger) для
 * браузеров без animation-timeline: view() — на момент написания это
 * Firefox с настройками по умолчанию. Без него CSS в global.css молча
 * прячет весь помеченный контент (opacity: 0) и никто его обратно не
 * показывает: пустая страница хуже, чем страница без анимаций.
 *
 * TODO(Task 6): переехать в Base.astro — сейчас подключается напрямую в
 * index.astro как временная площадка для теста.
 */
---

<script is:inline>
  (function () {
    // Браузер сам умеет анимировать по прокрутке — полифилл не нужен.
    if (CSS.supports('animation-timeline', 'view()')) return;
    // Без IntersectionObserver нечем возвращать видимость обратно —
    // тогда лучше не скрывать вовсе, чем скрыть и не показать.
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Метка ставится синхронно, до первой отрисовки. Правила скрытия в
    // CSS привязаны именно к ней, поэтому если этот скрипт не выполнится
    // (JS отключён) — класса не будет, и содержимое останется видимым.
    document.documentElement.classList.add('js-reveal');

    addEventListener('DOMContentLoaded', function () {
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -10% 0px' },
      );

      document.querySelectorAll('.reveal, .reveal-soft, .reveal-stagger').forEach(function (el) {
        io.observe(el);
      });
    });
  })();
</script>
