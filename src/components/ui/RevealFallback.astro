---
/**
 * Полифилл анимации появления (.reveal/.reveal-soft/.reveal-stagger) для
 * браузеров без animation-timeline: view() — на момент написания это
 * Firefox с настройками по умолчанию. Без него CSS в global.css молча
 * прячет весь помеченный контент (opacity: 0) и никто его обратно не
 * показывает: пустая страница хуже, чем страница без анимаций.
 *
 * Подключается в Base.astro, в <head>, как можно раньше: класс js-reveal
 * обязан встать до первой отрисовки, иначе будет заметная вспышка контента.
 * Если браузер сам умеет animation-timeline: view() или в нём нет
 * IntersectionObserver — полифилл не нужен и не трогает документ вовсе;
 * тогда лучше не скрывать контент, чем скрыть и не вернуть обратно.
 *
 * Скрипт внутри намеренно минифицирован в одну строку без комментариев:
 * весь клиентский JS сайта ограничен бюджетом 2 КБ суммарно на страницу
 * (см. src/layouts/Base.astro), и здесь каждый лишний байт в тексте
 * комментария конкурирует за этот бюджет с аналитикой. Комментарии в
 * этом файле — здесь, во фронтматтере, откуда они не попадают в сборку.
 */
---

<script is:inline>(function(){if(CSS.supports('animation-timeline','view()'))return;if(!('IntersectionObserver'in window))return;if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;document.documentElement.classList.add('js-reveal');addEventListener('DOMContentLoaded',function(){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;e.target.classList.add('is-visible');io.unobserve(e.target)})},{rootMargin:'0px 0px -10% 0px'});document.querySelectorAll('.reveal, .reveal-soft, .reveal-stagger').forEach(function(el){io.observe(el)})})})();</script>
