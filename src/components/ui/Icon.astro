---
/**
 * Цвет заливки/обводки запечён в каждый SVG (это разметка из Figma, не
 * currentColor), поэтому иконка подходит только под тот фон, под который
 * её нарисовал дизайнер. Ориентир по факту цвета в файле:
 *
 * - Белая заливка (white / #F6F6F6): brand-bosch, brand-hitachi, brand-lg,
 *   brand-samsung, icon-phone-white, icon-clock, icon-location-pin,
 *   icon-phone-light — только тёмные секции (Section tone="dark"/"soft"/
 *   "footer").
 * - Амбер #EFB726 (--color-amber): icon-card, icon-grid, icon-price-tag,
 *   icon-snowflake — тоже тёмные секции (амбер контрастен на графите,
 *   8.59:1, но почти нечитаем на кремовом, 1.69:1 — см. SectionHeading.astro).
 * - Бронза #8A6100 (--color-amber-ink): icon-price-tag-light,
 *   icon-speech-bubble, icon-wrench — светлые секции (tone="light"/"amber").
 * - Тёмная обводка #232323: icon-camera-industrial, icon-scroll-down —
 *   светлые/амбер секции (icon-scroll-down — на амберном кружке-якоре
 *   под первым экраном, node 1:411).
 * - Тёмно-зелёная заливка #08251A (--color-wa-ink): icon-whatsapp-bubble,
 *   icon-whatsapp-button, icon-whatsapp-nav — привязаны к зелёной плашке
 *   WhatsApp (bg-wa), а не к тону секции.
 * - icon-arrow-up-right / -alt — два оттенка зелёного под разный фон
 *   карточки поломки, смотреть по месту использования.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  /**
   * Доступное имя, когда иконка сама несёт смысл, а не просто украшает уже
   * читаемый рядом текст — единственный такой случай в проекте: логотипы
   * брендов без подписи в BrandList (LG, Samsung, Bosch, Hitachi — поисковик
   * содержимое SVG не читает, а слов бренда на самом рисунке иногда нет,
   * см. Bosch). По умолчанию иконка остаётся декоративной (aria-hidden,
   * как раньше); передав ariaLabel, получаем role="img" + aria-label
   * вместо aria-hidden — свою пару на каждый вызов, не общую на компонент.
   */
  ariaLabel?: string;
}

const { name, size = 24, class: className = '', ariaLabel } = Astro.props;

const files = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const key = `../../assets/icons/${name}.svg`;
const raw = files[key];
if (!raw) {
  throw new Error(`Иконка ${name} не найдена. Доступны: ${Object.keys(files).join(', ')}`);
}

/**
 * Все SVG выгружены из Figma одним инструментом и делят внутренние id
 * между файлами: например id="clip0_0_4" встречается во всех четырёх
 * brand-*.svg подряд, а id="Icon"/"Vector" — вообще во всех иконках.
 * Если два таких SVG окажутся на одной странице (ряд логотипов брендов),
 * оба clip-path="url(#clip0_0_4)" разрешатся в первое определение — и все
 * экземпляры кроме первого обрежутся чужой маской.
 *
 * Поэтому каждый вызов Icon получает собственный случайный префикс и
 * переписывает под него все id вместе со всеми способами на них
 * сослаться: url(#...) (в этой форме приходят значения атрибутов
 * clip-path/mask/fill/filter) и href="#..."/xlink:href="#...".
 * Уникальность нужна на экземпляр компонента, а не на файл — один и тот
 * же значок может быть выведен на странице несколько раз.
 */
const uid = `ic-${crypto.randomUUID().replace(/-/g, '').slice(0, 8)}`;

const withUniqueIds = raw
  .replace(/\bid="([^"]+)"/g, (_match, id: string) => `id="${uid}-${id}"`)
  .replace(/url\(#([^)"]+)\)/g, (_match, id: string) => `url(#${uid}-${id})`)
  .replace(/((?:xlink:)?href)="#([^"]+)"/g, (_match, attr: string, id: string) => `${attr}="#${uid}-${id}"`);

// Сначала снимаем существующие width/height с корневого <svg>, потом
// подставляем нужный размер. Порядок важен: если сперва вставить
// width/height, а затем чистить их регуляркой по всей разметке, чистка
// съест то, что только что вставили (а заодно и width/height у вложенных
// элементов вроде <rect> в clipPath, поэтому правим только открывающий тег
// корневого <svg>, а не весь документ).
const a11yAttrs = ariaLabel
  ? `role="img" aria-label="${ariaLabel.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}"`
  : `aria-hidden="true" focusable="false"`;

const markup = withUniqueIds.replace(/<svg\b([^>]*)>/, (_match, attrs: string) => {
  const withoutSize = attrs.replace(/\s(width|height)="[^"]*"/g, '');
  return `<svg${withoutSize} width="${size}" height="${size}" ${a11yAttrs}>`;
});
---

<span class={`inline-flex shrink-0 ${className}`} style={`width:${size}px;height:${size}px`} set:html={markup} />
