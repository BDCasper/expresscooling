---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

const files = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const key = `../../assets/icons/${name}.svg`;
const raw = files[key];
if (!raw) {
  throw new Error(`Иконка ${name} не найдена. Доступны: ${Object.keys(files).join(', ')}`);
}

/**
 * Все SVG выгружены из Figma одним инструментом и делят внутренние id
 * между файлами: например id="clip0_0_4" встречается во всех четырёх
 * brand-*.svg подряд, а id="Icon"/"Vector" — вообще во всех иконках.
 * Если два таких SVG окажутся на одной странице (ряд логотипов брендов),
 * оба clip-path="url(#clip0_0_4)" разрешатся в первое определение — и все
 * экземпляры кроме первого обрежутся чужой маской.
 *
 * Поэтому каждый вызов Icon получает собственный случайный префикс и
 * переписывает под него все id вместе со всеми способами на них
 * сослаться: url(#...) (в этой форме приходят значения атрибутов
 * clip-path/mask/fill/filter) и href="#..."/xlink:href="#...".
 * Уникальность нужна на экземпляр компонента, а не на файл — один и тот
 * же значок может быть выведен на странице несколько раз.
 */
const uid = `ic-${crypto.randomUUID().replace(/-/g, '').slice(0, 8)}`;

const withUniqueIds = raw
  .replace(/\bid="([^"]+)"/g, (_match, id: string) => `id="${uid}-${id}"`)
  .replace(/url\(#([^)"]+)\)/g, (_match, id: string) => `url(#${uid}-${id})`)
  .replace(/((?:xlink:)?href)="#([^"]+)"/g, (_match, attr: string, id: string) => `${attr}="#${uid}-${id}"`);

// Сначала снимаем существующие width/height с корневого <svg>, потом
// подставляем нужный размер. Порядок важен: если сперва вставить
// width/height, а затем чистить их регуляркой по всей разметке, чистка
// съест то, что только что вставили (а заодно и width/height у вложенных
// элементов вроде <rect> в clipPath, поэтому правим только открывающий тег
// корневого <svg>, а не весь документ).
const markup = withUniqueIds.replace(/<svg\b([^>]*)>/, (_match, attrs: string) => {
  const withoutSize = attrs.replace(/\s(width|height)="[^"]*"/g, '');
  return `<svg${withoutSize} width="${size}" height="${size}" aria-hidden="true" focusable="false">`;
});
---

<span class={`inline-flex shrink-0 ${className}`} style={`width:${size}px;height:${size}px`} set:html={markup} />
