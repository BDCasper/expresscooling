---
/**
 * Инерционная прокрутка колесом/тачпадом.
 *
 * ЗАЧЕМ. `html { scroll-behavior: smooth }` в global.css сглаживает
 * только переходы по якорям (ссылки меню), да и то Chrome даёт на них
 * ~300 мс независимо от расстояния — на длинном перелёте это читается
 * как прыжок. К самой прокрутке колесом CSS не относится вовсе: там
 * браузер двигает страницу дискретными шагами по 100 px на щелчок, и
 * никакой плавности не возникает. Отсюда «плавный скролл не ощущается».
 * Скрипт ниже перехватывает колесо и догоняет цель экспоненциальным
 * сглаживанием — та же инерция, что у тачпада macOS и у дизайн-студийных
 * лендингов.
 *
 * ПРОЙДЕННОЕ РАССТОЯНИЕ НЕ МЕНЯЕТСЯ. Дельта события кладётся в цель
 * один к одному (только с нормализацией deltaMode), множителя скорости
 * нет: щелчок колеса прокручивает страницу ровно на столько же, на
 * сколько прокрутил бы браузер. Меняется не скорость, а форма движения.
 * Множитель здесь был бы самой заметной и самой раздражающей правкой —
 * человек с настроенной под себя скоростью колеса сразу чувствует, что
 * сайт «уводит» страницу не туда, куда он крутил.
 *
 * ГДЕ НЕ ВКЛЮЧАЕТСЯ.
 * - prefers-reduced-motion: reduce — выходим сразу, ни одного слушателя.
 *   Ровно то же требование, что у остальных анимаций проекта
 *   (@media в global.css), и на этом же держится тест блокировки
 *   прокрутки в burger.spec.ts: он прогоняется с reducedMotion: 'reduce',
 *   то есть проверяет нативное поведение, не тронутое этим скриптом.
 * - Палец по экрану колесо не генерирует вовсе, поэтому нативная инерция
 *   тач-устройств остаётся нативной без всяких проверок на pointer/hover.
 *   Тачпад ноутбука с сенсорным экраном при этом сглаживание получает —
 *   так и надо, крутит-то он колесом.
 * - Ctrl/Cmd + колесо — это масштабирование, а не прокрутка; Shift +
 *   колесо в Firefox — прокрутка по горизонтали. Оба отдаём браузеру.
 * - `overflow-y: hidden` на <html> — так бургер-меню запирает страницу
 *   (Header.astro). Проверяем вычисленный стиль, а не конкретную
 *   inline-запись, которую ставит бургер: сглаживание не должно знать про
 *   реализацию меню. Пока страница заперта, колесо уходит браузеру и
 *   прокручивается сама панель меню (у её <nav> свой overflow-y-auto).
 *
 * ПОЧЕМУ behavior: 'instant', А НЕ window.scrollTo(0, y). Двухаргументная
 * форма scrollTo подчиняется CSS-свойству scroll-behavior, а оно у нас
 * smooth. Каждый кадр запускал бы поверх предыдущего ещё одну нативную
 * плавную прокрутку — вместо инерции получилась бы вязкая каша с
 * отставанием в полсекунды. 'instant' — единственная запись, которая
 * гарантированно игнорирует CSS (в отличие от 'auto', которая как раз
 * означает «как велит CSS»).
 *
 * ПОЧЕМУ ШАГ СЧИТАЕТСЯ ОТ dt, А НЕ ФИКСИРОВАННОЙ ДОЛЕЙ ЗА КАДР. Обычный
 * `pos += diff * 0.14` привязывает скорость затухания к частоте кадров:
 * на мониторе 120 Гц движение останавливается вдвое быстрее, чем на
 * 60 Гц, и «вес» прокрутки у двух людей на одном сайте разный. Доля
 * пересчитывается из фактического dt по формуле того же экспоненциального
 * затухания, поэтому кривая одна и та же при любом refresh rate. dt
 * подрезан сверху (64 мс): после переключения вкладки rAF приходит с
 * дырой в секунды, и без подрезки первый кадр после возврата прыгнул бы
 * сразу в цель.
 *
 * СИНХРОНИЗАЦИЯ С ЧУЖОЙ ПРОКРУТКОЙ. Позицию скрипт ведёт сам во float
 * (window.scrollY округляется браузером до физического пикселя, и чтение
 * его обратно каждый кадр съедало бы хвост движения — на dpr 1 остаток
 * меньше пикселя не применяется, и цикл замирал бы, не доехав). Но если
 * страницу сдвинул кто-то другой — клик по якорю меню, клавиатура,
 * перетаскивание полосы прокрутки, фокус по Tab — расхождение с
 * записанным значением больше 2 px, и цикл сдаётся, отдавая позицию тому,
 * кто её меняет, вместо перетягивания страницы назад к своей цели.
 */
---

<script is:inline>
  (function () {
    if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return;

    var root = document.documentElement;
    var pos = 0;
    var target = 0;
    var written = 0;
    var running = false;
    var prev = 0;

    function maxScroll() {
      return Math.max(0, root.scrollHeight - innerHeight);
    }

    function write(y) {
      written = y;
      scrollTo({ top: y, behavior: 'instant' });
    }

    function step(now) {
      // Страницу двигает кто-то ещё (якорь, клавиатура, полоса прокрутки) —
      // уступаем ему, а не тянем назад к своей цели.
      if (Math.abs(scrollY - written) > 2) {
        running = false;
        return;
      }
      var dt = Math.min(now - prev, 64);
      prev = now;
      var diff = target - pos;
      if (Math.abs(diff) < 0.5) {
        running = false;
        write(target);
        return;
      }
      // Доля остатка за кадр, приведённая к фактическому dt: при 60 Гц это
      // те же 0.14, при 120 Гц — половина, кривая затухания одна и та же.
      pos += diff * (1 - Math.pow(0.86, dt / 16.667));
      write(pos);
      requestAnimationFrame(step);
    }

    addEventListener(
      'wheel',
      function (ev) {
        if (ev.ctrlKey || ev.metaKey || ev.shiftKey || ev.defaultPrevented) return;
        if (!ev.deltaY) return;
        if (getComputedStyle(root).overflowY === 'hidden') return;

        // deltaMode: 0 — пиксели, 1 — строки (Firefox), 2 — страницы.
        var d = ev.deltaY * (ev.deltaMode === 1 ? 16 : ev.deltaMode === 2 ? innerHeight : 1);
        ev.preventDefault();

        if (!running) pos = target = scrollY;
        target = Math.max(0, Math.min(maxScroll(), target + d));
        if (!running) {
          running = true;
          prev = performance.now();
          requestAnimationFrame(step);
        }
      },
      { passive: false },
    );
  })();
</script>
