---
import { Image } from 'astro:assets';
import Section from './ui/Section.astro';
import WhatsAppButton from './ui/WhatsAppButton.astro';
import PhoneButton from './ui/PhoneButton.astro';
import Icon from './ui/Icon.astro';
import { site } from '../data/site';
import { images } from '../data/assets';
import { heroImageSizes, heroImageWidths } from '../lib/heroImage';

/**
 * Preload-ссылка на этот же файл — в <head>, собирается в index.astro
 * через getImage() с теми же heroImageWidths/heroImageSizes (см. lib/
 * heroImage.ts) и передаётся в Base.astro через именованный слот "head".
 * Собрать её прямо здесь не вышло: слой Astro, который сам переносит
 * элементы с slot="head" в <head> из вложенных компонентов, применяется
 * только к <style>/<script>, добавленным механизмом бандлинга, а не к
 * произвольным тегам — на практике (см. dist/index.html после сборки)
 * <link slot="head"> просто остаётся лежать в <body> as is, с атрибутом
 * slot="head" в выводе. Явный именованный слот в Base.astro — рабочий
 * вариант вместо этого.
 */

/**
 * Секция первого экрана — на всю ширину окна, а не внутри <Container>: в
 * макете (node 1:8) фото упирается в правый край экрана без отступа.
 * <Container> здесь не подходит — он центрирует блок с равными отступами
 * с обеих сторон и обрезал бы фото до внутренней границы контейнера.
 *
 * Текстовая колонка вместо этого получает тот же отступ слева, что даёт
 * Container (mx-auto max-w-[1320px] px-5 md:px-10): на мобильном — 20px
 * (px-5), от lg и до 1320px окна — 40px (px-10), а после 1320px — половина
 * остатка окна плюс те же 40px, чтобы текст оставался на одной вертикали
 * с контейнером шапки. `max(40px, calc(...))` даёт ровно эту дугу без
 * добавления отдельного брейкпоинта на 1320px.
 *
 * Порог переключения в две колонки — lg (1024px), а не md (768px), как
 * везде в остальном макете. Причина: текстовая колонка не резиновая — её
 * ширина держится содержимым (h1 максимум 567px), а не процентом, поэтому
 * фото получает только то, что осталось. На 768-1023px это остаток в
 * 100-230px — фото превращается в узкую полоску. Ниже lg макет остаётся
 * одноколоночным (как на мобильном), с фото на всю ширину под текстом —
 * для этого диапазона в макете нет отдельного разбора, но это те же
 * пропорции, что уже одобрены для мобильного узла 1:495, только на более
 * широком экране.
 *
 * Горизонтальный отступ текста при этом переключается по md (768px), как
 * и у Container: до md — 20px (px-5), от md до lg — 40px (md:px-10, тот
 * же паддинг, что использует Container на этой ширине), а от lg — та же
 * формула, что и раньше. Если бы отступ ждал lg вместе с колонками, текст
 * съезжал бы на 20px левее логотипа шапки (тот выровнен по Container,
 * переключается на md) во всём диапазоне 768-1023px.
 */
const heroLeftGutter = 'lg:pl-[max(40px,calc((100vw-1320px)/2+40px))]';
---

<Section tone="dark" id="hero" dataSection="hero" class="relative">
  <div class="flex flex-col lg:flex-row lg:items-stretch lg:gap-x-[60px]">
    <div class={`reveal px-5 py-10 md:px-10 lg:px-0 lg:py-16 ${heroLeftGutter}`}>
      <p class="text-[14px] font-bold uppercase tracking-[2.24px] text-amber">Алматы, заявки с 6:00</p>

      <h1
        data-testid="page-title"
        class="mt-[18px] max-w-[567px] text-[40px] font-bold leading-[40.8px] tracking-[-1.4px] text-chalk lg:text-[66px] lg:leading-[67.32px] lg:tracking-[-2.31px]"
      >
        Холодильник чинит тот, кто взял трубку
      </h1>

      <p class="mt-[22px] max-w-[481px] text-[19px] leading-[30.02px] text-chalk-body">
        {/*
          Макет: «Выезд по городу за 40-90 минут…». Число подставляется из
          site.responseTime («40-90 мин») вместо буквального «40-90
          минут» из макета: правило проекта запрещает вписывать время
          отклика в разметку напрямую, а держать одно и то же число
          продублированным двумя строками — источник рассинхронизации,
          если оно поменяется в site.ts.
        */}
        Звонки принимают сами мастера. Выезд по городу за {site.responseTime}, стоимость работ называем до начала
        ремонта.
      </p>

      {
        /*
          На мобильном (< md, node 1:491) это не две одинаковые пилюли, а
          широкая зелёная кнопка + отдельная круглая кнопка-телефон 56×56
          без номера справа от неё — от md возвращаются две обычные пилюли
          в ряд с номером (проверено на node 1:8 в прошлом раунде). Два
          варианта PhoneButton (round/pill) рендерятся как два отдельных
          <a> с одним и тем же data-cta="hero", а не один адаптивный —
          формы слишком разные (круг фиксированной ширины против пилюли с
          текстом), чтобы переключать классами один и тот же элемент, как
          сделано для короткой подписи WhatsAppButton в шапке. Второй
          <a data-cta> здесь не задваивает клики в аналитике (тот же
          принцип, что и у пары span'ов в шапке): на любой ширине виден и
          кликабелен только один из двух — у скрытого display:none, он не
          в accessibility-дереве и не ловит события клика.

          Видимость PhoneButton переключается обёрткой (<div>), а не
          классом на самой кнопке: у PhoneButton уже есть безусловный
          "inline-flex" внутри собственного base — если сюда же добавить
          className="hidden md:inline-flex" на тот же <a>, оба класса
          одного уровня специфичности (оба без брейкпоинт-префикса у
          "hidden") конкурируют за display, и какой победит — решает
          порядок генерации самого Tailwind, а не порядок классов в
          строке (поймано вживую: без обёртки пилюля с номером оставалась
          видимой и на мобильном, вылезая за край экрана). Обёртка не
          спорит ни с чем — на div нет своего display-класса, кроме
          hidden/md:block, поэтому побеждает предсказуемо. У round-кнопки
          та же ловушка не сработала бы (md:hidden с префиксом гарантированно
          позже безпрефиксного inline-flex в Tailwind), но для единообразия
          и она обёрнута.
        */
      }
      <div class="mt-[34px] flex items-center gap-[14px]">
        <WhatsAppButton source="hero" class="flex-1 md:flex-none" />
        <div class="md:hidden">
          <PhoneButton source="hero" variant="round" />
        </div>
        <div class="hidden md:block">
          <PhoneButton source="hero" variant="pill" />
        </div>
      </div>

      {
        /*
          grid grid-cols-2 вместо flex flex-wrap на мобильном: в макете
          (node 1:491) показатели стоят в две колонки даже на 390px, а
          подписи под числами при нехватке места переносятся на две
          строки внутри своей колонки — это ожидаемо, не баг. flex-wrap
          вместо этого переносил бы весь второй блок под первый, как
          только их суммарная содержимая ширина (макс. 246px на подпись
          × 2 + gap-x-14) переставала помещаться в строку — то есть
          всегда на мобильном, откуда и растянутый первый экран до этой
          правки. С md возвращается прежнее поведение (flex flex-wrap,
          колонки по ширине контента) — там места достаточно и так, менять
          не просили.
        */
      }
      <div class="mt-[46px] grid grid-cols-2 gap-x-14 gap-y-6 border-t border-white/13 pt-[31px] md:flex md:flex-wrap">
        <div>
          <p class="whitespace-nowrap text-[27px] font-extrabold tracking-[-0.756px] text-amber lg:text-[40px] lg:tracking-[-1.12px]">
            {site.hours.label}
          </p>
          <p class="mt-[9px] max-w-[246px] text-[16.785px] leading-[23.499px] text-chalk-muted">
            Принимаем заявки каждый день
          </p>
        </div>
        <div>
          <p class="whitespace-nowrap text-[27px] font-extrabold tracking-[-0.756px] text-amber lg:text-[40px] lg:tracking-[-1.12px]">
            {site.responseTime}
          </p>
          <p class="mt-[9px] max-w-[246px] text-[16.785px] leading-[23.499px] text-chalk-muted">
            Обычное время выезда по городу
          </p>
        </div>
      </div>
    </div>

    <div class="reveal-soft relative h-[300px] shrink-0 overflow-hidden rounded-bl-hero lg:h-auto lg:min-w-0 lg:flex-1">
      <Image
        src={images.heroMaster.src}
        alt={images.heroMaster.alt}
        width={2200}
        height={1228}
        widths={heroImageWidths}
        sizes={heroImageSizes}
        format="avif"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover object-[92%_50%]"
      />
    </div>
  </div>

  {
    /*
      hidden lg:flex — намеренно, не забытый брейкпоинт. В мобильном макете
      (node 1:491) этой круглой кнопки-якоря нет вообще: после фото сразу
      идёт полоса фактов, без кружка на стыке секций. Кнопка — только в
      десктопном узле (1:8, 1:411), поэтому и в разметке она есть только
      от lg, синхронно с переходом Hero в двухколоночный десктопный вид
      (см. комментарий у heroLeftGutter выше). Не удалять и не "чинить"
      показ на мобильном без сверки с 1:491.
    */
  }
  <a
    href="#polomki"
    aria-label="Смотреть частые поломки"
    class="absolute bottom-0 left-1/2 z-10 hidden h-[68px] w-[68px] -translate-x-1/2 translate-y-1/2 items-center justify-center rounded-full bg-amber shadow-[0_0_0_10px_var(--color-graphite)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-chalk lg:flex"
  >
    <Icon name="icon-scroll-down" size={22} />
  </a>
</Section>
