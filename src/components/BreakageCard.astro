---
import { Image } from 'astro:assets';
import WhatsAppButton from './ui/WhatsAppButton.astro';
import { images } from '../data/assets';
import type { Breakage } from '../data/breakages';

interface Props {
  breakage: Breakage;
  size: 'large' | 'small';
}

const { breakage, size } = Astro.props;
const image = images[breakage.imageKey];

/**
 * Амбером залита ровно одна карточка — та, у которой есть бейдж
 * («Начните отсюда», node 1:90). Раньше здесь стояло breakage.featured
 * (все четыре крупные), но featured в данных значит только «в первой
 * группе из четырёх», а не «выделенная цветом» — амбер/белый у крупных
 * и малых карточек не совпадает с этим делением: 3 из 4 крупных белые,
 * как и все 4 малые. Признак заливки — именно бейдж, у него сейчас
 * только одна карточка, и так и задумано (round 1 ревью).
 */
const highlighted = Boolean(breakage.badge);

/**
 * Крупные карточки (node 1:88) и малые (node 1:146) отличаются высотой
 * фото (204px / 167px) и размером шрифта заголовка/описания — оба набора
 * чисел взяты из get_design_context, округлены до целых пикселей.
 */
const sizes = {
  large: {
    imageHeight: 'md:h-[204px]',
    padX: 'md:px-[22px]',
    title: 'text-[25px] leading-[1.24]',
    titlePad: 'md:pt-5',
    desc: 'text-[18px] leading-[1.5]',
    descPad: 'md:pt-[10px]',
    ctaPad: 'md:pb-[22px] md:pt-[18px]',
  },
  small: {
    imageHeight: 'md:h-[167px]',
    padX: 'md:px-5',
    title: 'text-[21px] leading-[1.24]',
    titlePad: 'md:pt-[18px]',
    desc: 'text-[16.8px] leading-[1.5]',
    descPad: 'md:pt-[9px]',
    ctaPad: 'md:pb-5 md:pt-[14px]',
  },
} as const;

const s = sizes[size];
---

<div
  data-breakage={breakage.slug}
  class={`group relative flex flex-row overflow-hidden rounded-card border transition-transform duration-200 ease-soft hover:-translate-y-1 md:flex-col ${highlighted ? 'border-amber' : 'border-black/10'}`}
>
  <div class={`relative w-[104px] shrink-0 overflow-hidden md:w-full ${s.imageHeight}`}>
    <Image
      src={image.src}
      alt={image.alt}
      width={700}
      height={522}
      format="avif"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-200 ease-soft group-hover:scale-[1.03]"
    />
  </div>

  <div class={`relative flex flex-1 flex-col p-4 md:p-0 ${highlighted ? 'bg-amber' : 'bg-white'}`}>
    {
      breakage.badge && (
        <p class="text-[14px] font-bold uppercase tracking-[1.96px] text-[#231c05]/80 md:px-5 md:pt-[18px]">
          {breakage.badge}
        </p>
      )
    }
    <p class={`font-bold ${s.title} ${s.padX} ${breakage.badge ? 'mt-2 md:mt-0' : ''} ${s.titlePad} ${highlighted ? 'text-[#231c05]' : 'text-ink'}`}>
      {breakage.title}
    </p>
    <p class={`mt-2 ${s.desc} ${s.padX} ${s.descPad} ${highlighted ? 'text-[#231c05]/74' : 'text-ink-muted'}`}>
      {breakage.description}
    </p>
    <div class={`mt-auto pt-3 ${s.padX} ${s.ctaPad}`}>
      <WhatsAppButton variant="inline" source={`card-${breakage.slug}`} onAmber={highlighted} />
    </div>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-0 bg-amber transition-[height] duration-200 ease-soft group-hover:h-1"
    />
  </div>
</div>
