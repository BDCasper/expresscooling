---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsBar from '../components/FactsBar.astro';
import Breakages from '../components/Breakages.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import PhoneButton from '../components/ui/PhoneButton.astro';
import Icon from '../components/ui/Icon.astro';
import { images } from '../data/assets';
import { heroImageSizes, heroImageWidths } from '../lib/heroImage';

/**
 * Приоритетная предзагрузка фото первого экрана (LCP). widths здесь —
 * буквально те же heroImageWidths, что использует <Image> в Hero.astro,
 * поэтому getImage() строит тот же набор кандидатов srcset, что окажется
 * в итоговом <img>: браузер выбирает из preload и из <img> один и тот же
 * файл по одинаковым (srcset, sizes, viewport) — не предзагружает
 * случайный вариант, который потом не пригодится.
 */
const heroPreload = await getImage({
  src: images.heroMaster.src,
  widths: heroImageWidths,
  format: 'avif',
});
---

<Base
  title="Ремонт холодильников в Алматы — Express Cooling"
  description="Ремонт холодильников и холодильного оборудования в Алматы. Звонки принимают сами мастера, выезд за 40-90 минут, диагностика от 3500 ₸, стоимость называем до начала работ."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroImageSizes}
    fetchpriority="high"
  />
  <Header />
  <main>
    <Hero />
    <FactsBar />
    <Breakages />

    <!-- Заглушки якорей шапки: настоящие секции появятся в задачах 9-10,
         сборка index.astro со всеми секциями — в задаче 12. Тест
         tests/e2e/header-hero.spec.ts проверяет, что все 4 ссылки навигации
         ведут в существующие узлы уже сейчас. Якорь #polomki теперь живёт
         внутри <Breakages> (Section id="polomki"), а не заглушкой здесь. -->
    <div id="kak-rabotaem"></div>
    <div id="oborudovanie"></div>
    <div id="dlya-biznesa"></div>
  </main>

  <!-- Временный вывод UI-примитивов для tests/e2e/primitives.spec.ts и
       tests/e2e/reveal-fallback.spec.ts. Удаляется в Task 12, когда секции
       начнут использовать те же примитивы по-настоящему. Внизу страницы,
       под заглушками якорей — не мешает сверке Header/Hero с макетом. -->
  <WhatsAppButton source="test-primitive" />
  <PhoneButton source="test-phone" />
  <div id="test-icons">
    <Icon name="brand-lg" />
    <Icon name="brand-samsung" />
    <Icon name="brand-bosch" />
    <Icon name="brand-hitachi" />
  </div>
  <p class="reveal" data-testid="reveal-probe">Проверка появления контента</p>
  {
    /*
      Пробник — последний узел документа: без пространства под ним
      reveal-fallback.spec.ts физически не может прокрутить его в зону
      срабатывания. IntersectionObserver в RevealFallback.astro задан с
      rootMargin '0px 0px -10% 0px' — это намеренно (не считать появлением
      сантиметр, едва вылезший из-за нижнего края). Когда под пробником
      нет вообще ничего, максимальная прокрутка страницы всегда ставит его
      нижний край вровень с нижним краем вьюпорта — то есть ровно в те
      исключённые 10%, сколько бы контента ни было выше. Этот распорок
      даёт странице запас, чтобы пробник можно было докрутить по-настоящему
      в кадр, а не только к его границе. Уходит вместе со всем временным
      блоком в Task 12, когда после Hero появятся настоящие секции с
      реальной высотой.
    */
  }
  <div class="h-[60vh]" aria-hidden="true"></div>
</Base>
